# ==============================================================================
# CrimeMind Database Layer - Environment Configuration Template
# Copy this file to .env and adjust variables to match your PostgreSQL instance.
# ==============================================================================

# Full PostgreSQL Connection URL (Preferred)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crimemind

# Individual Database Parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimemind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Synthetic Generation & Seeding Settings
SYNTHETIC_DATA_SCALE=1.0
SYNTHETIC_SEED=42
DATA_DIR=database/seed/data

# Application Security & Audit
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# Google OAuth 2.0 Configuration
# ==============================================================================
GOOGLE_CLIENT_ID=888824302509-u2geafh9b1hn9sob0tp9d8iuai91v83n.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_PROJECT_ID=glass-badge-468110-d1

# Google OAuth Endpoints
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CERTS_URI=https://www.googleapis.com/oauth2/v1/certs

# Application Configuration
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
APP_BASE_URL=http://localhost:3000
