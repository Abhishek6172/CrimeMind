# ==============================================================================
# CrimeMind LangGraph Multi-Agent Engine - Environment Configuration
# ==============================================================================

# Database Connection (shared with PostgreSQL database layer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crimemind

# Multi-LLM Provider Architecture Configuration
# Supported providers: gemini, openai, anthropic, openrouter, local, mock
DEFAULT_LLM_PROVIDER=gemini

PLANNER_MODEL=gemini-2.0-flash
REASONING_MODEL=gemini-2.0-pro-exp
EXTRACTION_MODEL=gemini-2.0-flash
SYNTHESIS_MODEL=gemini-2.0-pro-exp
VISION_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# API Keys (set according to configured provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Agent Execution & Safety Bounds
MAX_CONCURRENT_AGENTS=8
AGENT_TIMEOUT_SECONDS=45
CONFIDENCE_THRESHOLD=0.75
ENABLE_LEGAL_SAFETY_VERIFICATION=True
ENABLE_STREAMING=True
LOG_LEVEL=INFO
