# ==============================================================================
# CrimeMind Intelligence Platform - Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=CrimeMind API
APP_VERSION=2.4.0
HOST=0.0.0.0
PORT=8000

# Database Configuration (matches docker-compose and PostgreSQL seed layer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crimemind
# For asyncpg if used:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crimemind
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security & Authentication
JWT_SECRET_KEY=crimemind-super-secret-fips140-cryptographic-vault-key-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google OAuth 2.0 configuration
GOOGLE_CLIENT_ID=888824302509-u2geafh9b1hn9sob0tp9d8iuai91v83n.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_PROJECT_ID=glass-badge-468110-d1

# Google OAuth endpoints
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CERTS_URI=https://www.googleapis.com/oauth2/v1/certs

# Application configuration
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
APP_BASE_URL=http://localhost:3000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# LangGraph AI Configuration
AI_CONFIDENCE_THRESHOLD=0.75
ENABLE_SYNTHETIC_LLM_STREAM=True
LANGGRAPH_MAX_AGENT_RETRIES=3

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
